---
// 정비 사례 상세 — 사이트 최상위 경로 라우트. 리딩 컬럼(980px).
// URL 방침(2026-08-09 확정): 워드프레스 원본 슬러그를 그대로 최상위에 유지한다 (/cases/ 하위 금지).
// 라우팅은 오직 프론트매터 slug 값만 사용 — 제목·폴더명 기반 자동 생성 금지.
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import { cta } from '../data/business.ts';
import { casePostNode, faqNode } from '../data/structuredData.ts';

export async function getStaticPaths() {
  const cases = await getCollection('cases');

  // 예약 경로 가드 — 기존 페이지·정적 자산과 충돌하면 조용히 가려지는 대신 빌드를 실패시킨다
  const RESERVED = new Set([
    'services', 'cases', 'equipment', 'location', 'contact',
    'docs', 'fonts', 'img', '_astro', '404',
    'robots.txt', 'favicon.ico', 'apple-touch-icon.png',
    'og-default.jpg', 'sitemap-index.xml', 'sitemap-0.xml',
    'dongtan-import-car-specialty-motor-repair-introduction', // 업체 소개 정적 페이지 (WP 슬러그 승계)
  ]);
  const seen = new Set<string>();
  for (const e of cases) {
    const s = e.data.slug;
    if (RESERVED.has(s) || RESERVED.has(s.split('/')[0])) {
      throw new Error(`[cases] 슬러그가 예약 경로와 충돌합니다: "${s}" (${e.id})`);
    }
    if (seen.has(s)) throw new Error(`[cases] 슬러그 중복: "${s}"`);
    seen.add(s);
  }

  return cases.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry, all: cases },
  }));
}

const { entry, all } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const selfId = entry.id;
// 관련 사례: 같은 브랜드 또는 같은 카테고리, 자기 제외, 최신순 최대 3개
const related = all
  .filter((e) => e.id !== selfId && (e.data.brand === d.brand || e.data.category === d.category))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const dateText = d.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });

// og:image = 사례 thumbnail (06 §5)
// ⚠️ jpeg 고정 — 카카오톡·네이버 공유 카드는 WebP 썸네일 렌더가 불안정하다.
//    사례 글은 개별 공유 빈도가 가장 높은 콘텐츠라 호환 포맷을 쓴다.
// 원본 비율을 그대로 유지하고 가로만 1200 으로 맞춘다. 업스케일도 크롭도 하지 않는다.
//  - 크롭하지 않는 이유: 대표 이미지 하단 16% 가 오버레이 띠(차종·작업 내용)다.
//    1200×630 으로 자르면 그 띠가 잘려나가 공유 카드에서 오버레이가 사라진다.
//  - 업스케일하지 않는 이유: 도면·캡처처럼 작은 컷을 대표로 쓰는 사례가 있다.
// getImage 에 height 를 넘겨도 가로만 맞춰지므로(실측), 높이는 직접 계산해 메타에 싣는다.
// libvips 는 리사이즈 높이를 round-half-to-even 으로 정한다. Math.round 를 쓰면
// 정확히 .5 인 경우(예: 1600×862 → 646.5) 메타가 실물과 1px 어긋난다.
const rint = (x: number) => {
  const f = Math.floor(x);
  const diff = x - f;
  if (diff > 0.5) return f + 1;
  if (diff < 0.5) return f;
  return f % 2 === 0 ? f : f + 1;
};
const th = d.thumbnail;
const ogW = Math.min(1200, th.width);
const ogH = rint((th.height * ogW) / th.width);
const ogImg = await getImage({ src: th, width: ogW, format: 'jpeg' });

// ── JSON-LD ────────────────────────────────────────────
// canonical 은 BaseLayout 과 같은 방식으로 만든다 — 한글 슬러그가 동일하게 퍼센트 인코딩돼야
// @id 와 canonical 이 어긋나지 않는다.
const site = Astro.site!;
const canonical = new URL(`/${d.slug}/`, site).href;
const schema = [
  casePostNode(site, {
    canonical,
    headline: d.title,
    description: d.description,
    // date = 작성·발행일 (예외 없음). Date 는 UTC 자정으로 파싱되므로 날짜만 잘라 쓴다.
    datePublished: d.date.toISOString().slice(0, 10),
    // 본문 Figure 방식(src= 73건 / img={} 4건)과 무관 — thumbnail 은 77건 모두 astro image() 라
    // 여기 한 경로로 절대 URL 이 만들어진다.
    image: new URL(ogImg.src, site).href,
    brand: d.brand,
    carModel: d.car_model,
    // tags 전량(30개 내외)은 스키마에 넣지 않는다 — 키워드 나열로 읽힐 소지가 있다.
    keywords: [d.focus_keyword, d.brand, d.car_model, d.category],
  }),
  faqNode(canonical, d.faq),
];
---

<BaseLayout
  title={d.seo_title}
  description={d.description}
  path={`/${d.slug}/`}
  ogImage={ogImg.src}
  ogImageWidth={ogW}
  ogImageHeight={ogH}
  breadcrumbs={[{ name: '정비 사례', path: '/cases/' }, { name: d.title, path: `/${d.slug}/` }]}
  schema={schema}
>
  <article class="case container">
    <!-- [1] 헤드 -->
    <header class="case-head">
      <h1 class="t-display-lg">{d.title}</h1>
      <p class="case-meta t-caption">
        <time datetime={d.date.toISOString()}>{dateText}</time> · {d.brand}{d.mileage_km != null && ` · 주행 ${d.mileage_km.toLocaleString()}km`}
      </p>
    </header>

    <!-- GEO 요약 카드 (한눈에 보기) -->
    <aside class="case-summary">
      <p class="lead t-body-strong">{d.summary_lead}</p>
      <dl>
        <div><dt>차종</dt><dd>{d.car_model}{d.mileage_km != null && ` / ${d.mileage_km.toLocaleString()}km`}</dd></div>
        <div><dt>증상</dt><dd>{d.symptom_customer.join(' · ')}</dd></div>
        <div><dt>진단</dt><dd>{d.diagnostic.join(' · ')}</dd></div>
        <div><dt>원인</dt><dd>{d.diagnosis_cause}</dd></div>
        <div><dt>수리</dt><dd>{d.parts_used.join(' · ')}</dd></div>
        <div><dt>결과</dt><dd>{d.result}</dd></div>
      </dl>
    </aside>

    <!-- [2] 본문 -->
    <div class="case-body">
      <Content />
    </div>

    <!-- [3] FAQ (펼친 상태) -->
    <section class="case-faq">
      <h2 class="t-display-md">자주 묻는 질문</h2>
      {d.faq.map((f) => (
        <div class="faq-item">
          <h3 class="t-body-strong">{f.q}</h3>
          <p class="t-body">{f.a}</p>
        </div>
      ))}
    </section>

    <!-- [4] 전환 블록 -->
    <section class="case-cta">
      <p class="t-tagline">비슷한 증상이신가요? 증상을 말씀해 주시면 원인부터 확인해 드립니다.</p>
      <div class="case-cta-buttons">
        <a href={cta.callHref} class="btn btn-call">{cta.callLabel}</a>
        <a href={cta.naverHref} target="_blank" rel="noopener noreferrer" class="btn btn-naver">{cta.naverLabel}</a>
      </div>
      <p class="case-cta-note t-caption">예: {d.symptom_customer.map((s) => `“${s}”`).join(' · ')} 같은 증상</p>
    </section>

    <!-- [5] 관련 사례 -->
    {related.length > 0 && (
      <section class="case-related">
        <h2 class="t-display-md">관련 정비 사례</h2>
        <div class="related-grid">
          {related.map((e) => <CaseCard entry={e} />)}
        </div>
      </section>
    )}

    <p class="case-outro t-caption">바쁜 일정에도 찾아주셔서 고맙습니다. 언제나 안전운전입니다. 모터리페어</p>
  </article>
</BaseLayout>

<style>
  .case { max-width: var(--reading-max); padding-block: var(--space-xxl); }
  .case-head h1 { color: var(--color-ink); margin: 0 0 12px; }
  .case-meta { color: var(--color-ink-muted-48); margin: 0; }

  .case-summary {
    background: var(--color-canvas-parchment);
    border-radius: var(--rounded-lg);
    padding: var(--space-lg);
    margin: var(--space-xl) 0;
  }
  .case-summary .lead { margin: 0 0 var(--space-md); color: var(--color-ink); }
  .case-summary dl { margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .case-summary dl div { display: flex; gap: var(--space-sm); padding: 4px 0; }
  .case-summary dt { min-width: 56px; color: var(--color-ink-muted-48); flex-shrink: 0; }
  .case-summary dd { margin: 0; color: var(--color-ink); }

  /* 한글 장문 본문만 행간 1.6 (DESIGN-motorrepair §6) */
  .case-body { font-size: 17px; line-height: 1.6; letter-spacing: -0.01em; color: var(--color-body); }
  .case-body :global(p) { margin: 0 0 var(--space-md); }

  .case-faq { margin-top: var(--space-section); }
  .case-faq h2 { color: var(--color-ink); margin-bottom: var(--space-lg); }
  .faq-item { padding: var(--space-md) 0; border-top: 1px solid var(--color-hairline); }
  .faq-item h3 { margin: 0 0 6px; color: var(--color-ink); }
  .faq-item p { margin: 0; color: var(--color-ink-muted-80); }

  .case-cta {
    margin-top: var(--space-section);
    padding: var(--space-xl);
    background: var(--color-canvas-parchment);
    border-radius: var(--rounded-lg);
    text-align: center;
  }
  .case-cta > .t-tagline { color: var(--color-ink); margin: 0 0 var(--space-lg); }
  .case-cta-buttons { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .case-cta-note { color: var(--color-ink-muted-48); margin: var(--space-md) 0 0; }

  .case-related { margin-top: var(--space-section); }
  .case-related h2 { color: var(--color-ink); margin-bottom: var(--space-lg); }
  .related-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); }

  .case-outro { color: var(--color-ink-muted-48); margin-top: var(--space-xxl); text-align: center; }

  @media (min-width: 641px) {
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 835px) {
    .related-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
