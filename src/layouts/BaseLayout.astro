---
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FabContact from '../components/FabContact.astro';
import { business } from '../data/business.ts';
import {
  autoRepairNode,
  webSiteNode,
  webPageNode,
  breadcrumbNode,
  graph,
  type Crumb,
} from '../data/structuredData.ts';
// JSON-LD image·logo 는 실제 사이트 자산을 가리켜야 한다 — 빌드된 절대 URL 로 넘긴다.
// 원본 import 의 .src 를 쓰므로 이미지 변환이 추가로 일어나지 않는다.
import exteriorFront from '../assets/site/IMG-001.jpg';
import exteriorSign from '../assets/site/IMG-013.jpg';
import exteriorSpring from '../assets/site/IMG-021.jpg';
import logoAsset from '../assets/logo-horizontal.png';

// 파비콘(2026-08-16): 원형 엠블럼. favicon.ico 에 16·32·48 프레임(알파) 포함.
//   16·32 프레임은 NOW·REPAIR 글자를 뺀 단순화본 — 그 크기에선 글자가 붉은 얼룩으로 뭉개져 형태를 흐린다.
//   apple-touch-icon 은 흰 배경 유지(iOS 는 알파를 무시하고 검게 합성한다).
//   구 favicon.svg(파란 M 임시 심볼)는 삭제 — 링크로 남기면 브라우저가 SVG 를 우선해 옛 심볼이 뜬다.

interface Props {
  title: string;
  description: string;
  /** canonical 경로 (예: "/services/") — 미지정 시 현재 URL */
  path?: string;
  /** 문의 페이지 등: 하단 전환 요소 중복 방지로 FAB 숨김 (03 공통 §3) */
  hideFab?: boolean;
  /** og:image 경로 (예: 사례 thumbnail). 미지정 시 브랜드 기본 OG 이미지 */
  ogImage?: string;
  /**
   * og:image 실제 크기. 미지정 시 기본 OG 이미지 규격(1200×630).
   * 원본이 작아 업스케일하지 않은 경우 실제 값을 넘겨야 한다 — 메타가 실제와 다르면
   * 공유 카드가 잘못된 영역을 잡는다.
   */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /**
   * OG·트위터 전용 설명. 미지정 시 description 을 그대로 쓴다.
   * 카카오톡 공유 카드는 앞 50~60자만 노출한다 — 검색용 메타 디스크립션(키워드 밀도 우선)과
   * 공유 카드용 문구(첫 문장에서 판단이 끝나야 함)의 요구가 달라 분리한다.
   */
  ogDescription?: string;
  /**
   * 빵부스러기 경로 — 홈 뒤의 항목만 넘긴다(홈은 자동으로 붙는다).
   * 메인 페이지에는 넘기지 않는다 (04단계 규칙).
   */
  breadcrumbs?: Crumb[];
  /**
   * 이 페이지 고유의 JSON-LD 노드 (BlogPosting·FAQPage 등). 같은 @graph 안에 합쳐진다.
   * ⚠️ 페이지에서 <script type="application/ld+json"> 을 직접 쓰지 말 것 — 출력 지점은 여기 하나다.
   */
  schema?: Record<string, unknown>[];
}

// 기본 OG 이미지는 jpeg — 사진 카드라 PNG 는 1.2MB 로 과하고, 카카오톡·네이버 호환도 jpeg 가 안전하다
const {
  title,
  description,
  path,
  hideFab = false,
  ogImage = '/og-default.jpg',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogDescription,
  breadcrumbs,
  schema = [],
} = Astro.props;
const ogDesc = ogDescription ?? description;
const canonical = new URL(path ?? Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// Google 태그 관리자 컨테이너 ID — 이 한 곳에서만 관리한다.
// GA4·전환 추적 등 태그는 GTM 웹 UI 에서 붙인다(코드 수정 불필요).
const GTM_ID = 'GTM-57TMPLH';
const gtmSnippet = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${GTM_ID}');`;

// ── JSON-LD ────────────────────────────────────────────
// 한 페이지의 모든 노드를 @graph 하나에 담는다. 조립 규칙은 src/data/structuredData.ts 주석 참조.
//  - 사업체(AutoRepair)·사이트(WebSite) 전체 정의: 메인 페이지에서만
//  - 다른 페이지: WebPage 가 publisher 로 #business 를 참조 + 빵부스러기 + 페이지 고유 노드
const site = Astro.site!;
const isHome = new URL(canonical).pathname === '/';
const absolute = (src: string) => new URL(src, site).href;

const nodes: Record<string, unknown>[] = [
  ...(isHome
    ? [
        autoRepairNode(site, {
          images: [exteriorFront.src, exteriorSign.src, exteriorSpring.src].map(absolute),
          logo: absolute(logoAsset.src),
        }),
        webSiteNode(site),
      ]
    : []),
  webPageNode(site, { canonical, title, description }),
  ...(breadcrumbs?.length ? [breadcrumbNode(site, breadcrumbs)] : []),
  ...schema,
];
const jsonLd = graph(nodes);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Tag Manager — head 최상단에 둔다(GTM 권장) -->
    <script is:inline set:html={gtmSnippet} />
    <!-- End Google Tag Manager -->

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- 파비콘 -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- JSON-LD (@graph) — 출력 지점은 사이트 전체에서 이 한 곳뿐이다 -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- 페이지별 추가 head (JSON-LD 는 여기 넣지 말 것 — schema prop 사용) -->
    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) — body 여는 태그 바로 뒤 -->
    <noscript
      ><iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!hideFab && <FabContact />}
  </body>
</html>
