---
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FabContact from '../components/FabContact.astro';
import { business } from '../data/business.ts';

// 파비콘(2026-08-16): 원형 엠블럼. favicon.ico 에 16·32·48 프레임(알파) 포함.
//   16·32 프레임은 NOW·REPAIR 글자를 뺀 단순화본 — 그 크기에선 글자가 붉은 얼룩으로 뭉개져 형태를 흐린다.
//   apple-touch-icon 은 흰 배경 유지(iOS 는 알파를 무시하고 검게 합성한다).
//   구 favicon.svg(파란 M 임시 심볼)는 삭제 — 링크로 남기면 브라우저가 SVG 를 우선해 옛 심볼이 뜬다.

interface Props {
  title: string;
  description: string;
  /** canonical 경로 (예: "/services/") — 미지정 시 현재 URL */
  path?: string;
  /** 문의 페이지 등: 하단 전환 요소 중복 방지로 FAB 숨김 (03 공통 §3) */
  hideFab?: boolean;
  /** og:image 경로 (예: 사례 thumbnail). 미지정 시 브랜드 기본 OG 이미지 */
  ogImage?: string;
  /**
   * OG·트위터 전용 설명. 미지정 시 description 을 그대로 쓴다.
   * 카카오톡 공유 카드는 앞 50~60자만 노출한다 — 검색용 메타 디스크립션(키워드 밀도 우선)과
   * 공유 카드용 문구(첫 문장에서 판단이 끝나야 함)의 요구가 달라 분리한다.
   */
  ogDescription?: string;
}

const { title, description, path, hideFab = false, ogImage = '/og-default.png', ogDescription } = Astro.props;
const ogDesc = ogDescription ?? description;
const canonical = new URL(path ?? Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// ── JSON-LD: AutoRepair (LocalBusiness 하위) — 05_local_business §3 ──
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  name: business.name,
  alternateName: business.alternateName,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.locality,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  telephone: business.phone.intl,
  url: Astro.site?.href,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: business.hours.weekday.opens,
      closes: business.hours.weekday.closes,
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: business.hours.saturday.opens,
      closes: business.hours.saturday.closes,
    },
  ],
  areaServed: [...business.seoRegions], // A계열 — SEO 키워드 축
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.address.geo.lat,
    longitude: business.address.geo.lng,
  },
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- 파비콘 -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- JSON-LD: AutoRepair -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- 페이지별 추가 head (예: 사례 상세의 FAQPage JSON-LD) -->
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!hideFab && <FabContact />}
  </body>
</html>
